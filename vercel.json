{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?route=robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index?route=llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index?route=llms-full.txt"
    },
    {
      "source": "/f9b0d72bd23251ea78cc1840b4878e29.txt",
      "destination": "/api/index?route=f9b0d72bd23251ea78cc1840b4878e29.txt"
    },
    {
      "source": "/",
      "destination": "/api/index?route="
    },
    {
      "source": "/explore",
      "destination": "/api/index?route=explore"
    },
    {
      "source": "/map",
      "destination": "/api/index?route=map"
    },
    {
      "source": "/profile",
      "destination": "/api/index?route=profile"
    },
    {
      "source": "/admin",
      "destination": "/api/index?route=admin"
    },
    {
      "source": "/about",
      "destination": "/api/index?route=about"
    },
    {
      "source": "/c/:id",
      "destination": "/api/index?route=c/:id"
    },
    {
      "source": "/q/:id",
      "destination": "/api/index?route=q/:id"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{templates/**,public/places.json,public/faq.js}",
      "maxDuration": 10
    }
  },
  "regions": [
    "iad1"
  ]
}